{
  "name": "the-reverse-watch",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:partners": "node --env-file=.env --import tsx scripts/dev-partners.ts",
    "start": "node scripts/start-server.mjs",
    "typegen": "react-router typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "lint": "npm run typegen && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && node --env-file-if-exists=.env ./node_modules/@playwright/test/cli.js test",
    "test:partners": "node --env-file=.env ./node_modules/@playwright/test/cli.js test --config playwright.partners.config.ts",
    "migrate:seed-catalogue-v3": "tsx scripts/migrate-seed-catalogue-v3.ts",
    "audit:model-intake": "tsx scripts/audit-model-intake.ts",
    "build:watches-workbook": "tsx scripts/build-watches-models-workbook.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@react-router/node": "^7.18.2",
    "@react-router/serve": "^7.18.2",
    "@sentry/react-router": "^10.78.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/react-router": "^1.3.6",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^7.18.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^16.4.0",
    "jsdom": "^30.0.1",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "@vercel/static-config": {
      "ajv": "8.18.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@sentry/cli@2.58.6": true
  }
}
