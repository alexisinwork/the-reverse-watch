{
  "name": "the-reverse-watch",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/nodejs_*/index.js",
    "typegen": "react-router typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && node --env-file-if-exists=.env ./node_modules/@playwright/test/cli.js test",
    "project:seed-coverage": "tsx scripts/project-seed-coverage.ts",
    "render:seed-migration": "tsx scripts/render-seed-migration.ts",
    "render:compact-catalogue-migration": "tsx scripts/render-compact-catalogue-migration.ts",
    "audit:catalogue-parity": "tsx scripts/audit-catalogue-parity.ts",
    "audit:coverage": "tsx scripts/audit-coverage.ts",
    "evaluate:baseline": "tsx scripts/evaluate-deterministic-baseline.ts",
    "audit:research": "tsx scripts/audit-research-manifest.ts",
    "plan:research": "tsx scripts/plan-coverage-research.ts",
    "import:knowledge": "tsx scripts/import-knowledge-base.ts --write",
    "audit:knowledge": "tsx scripts/import-knowledge-base.ts --check",
    "sync:knowledge-manifest": "tsx scripts/sync-knowledge-manifest.ts",
    "research": "node --env-file=.env --import tsx scripts/run-research-worker.ts",
    "research:sync-intake": "tsx scripts/sync-research-workbook-intake.ts",
    "research:review-rolex-intake": "tsx scripts/review-rolex-workbook-intake.ts",
    "research:promote-rolex": "tsx scripts/promote-rolex-workbook.ts",
    "research:export-rolex-workbook": "tsx scripts/export-rolex-research-workbook.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "dependencies": {
    "@react-router/node": "^7.18.2",
    "@react-router/serve": "^7.18.2",
    "@sentry/react-router": "^10.72.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/react-router": "^1.3.6",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^7.18.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^16.4.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "@vercel/static-config": {
      "ajv": "8.18.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
