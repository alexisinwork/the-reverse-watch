# The Reserve — local configuration template
# Copy this file to .env and fill only the variables required for the phase
# being developed. Never commit .env or real credentials.
# See docs/accounts-and-secrets.md for where every value comes from.

# Application origin (Phase 1)
APP_URL=http://localhost:5173

# Signed questionnaire/session state (only if Phase 2 later moves state from
# browser sessionStorage to server-side sessions)
SESSION_SECRET=replace-with-a-long-random-value
LOG_LEVEL=info

# Beehiiv server-side opt-in (Phase 1/5)
# The existing embedded signup form does not require these credentials.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Perplexity Agent API and research MCP (Phase 5)
PERPLEXITY_API_KEY=
PERPLEXITY_STANDARD_PRESET=pro-search
PERPLEXITY_DEEP_RESEARCH_PRESET=deep-research
PERPLEXITY_ADVANCED_RESEARCH_PRESET=advanced-deep-research

# PostgreSQL catalogue and deterministic recommendations (Phase 3/4)
# The selected provider is Supabase. Use its transaction pooler for application
# traffic and a direct/session-pooler connection for migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Supabase management uses project-scoped MCP OAuth. Add public Supabase client
# variables only if a later feature has a concrete need for the Supabase API.

# Optional semantic experiment provider selection (Phase 6)
# Supported target values will be validated when the provider adapter is built.
AI_PROVIDER=openai

# Optional research normalization/audit (Phase 5) and semantic experiment
# (Phase 6). None of these variables is required by the SQL-first baseline.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=
OPENAI_INGESTION_MODEL=gpt-5.6-luna
OPENAI_RECOMMENDATION_MODEL=gpt-5.6-terra
OPENAI_AUDIT_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_STORE_RESPONSES=false

# Ollama alternative for the optional Phase 6 experiment
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# GitHub and Vercel automation/MCP (Phase 1)
# Prefer OAuth for Vercel MCP. VERCEL_TOKEN is for non-interactive CLI jobs only.
GITHUB_PAT_TOKEN=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Third-party library documentation MCP (optional higher limits)
CONTEXT7_API_KEY=

# Rate limiting and scheduled refresh jobs (Phase 7)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=

# Transactional delivery of a generated dossier (Phase 7, optional)
RESEND_API_KEY=
EMAIL_FROM=

# Production observability (Phase 7, optional)
SENTRY_DSN=
